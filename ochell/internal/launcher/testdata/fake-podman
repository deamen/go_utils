#!/bin/bash
# Test stand-in for podman, used where the tests must not depend on it (CI,
# "make test").
#
# "run" understands the options the podman launcher passes, each as
# --name=value. It records its arguments in $FAKE_PODMAN_DIR/<name>.args (one
# per line), and runs the command in the --workdir with a clean environment
# plus --env and --env-file. There is no container: the command sees the
# host's files. A --volume whose target differs from its source is undone in
# the environment, so that HOME is the directory on the host.
#
# "stop" and "rm" end a "container" through the pid file written here. Each
# call is added to $FAKE_PODMAN_DIR/calls.
#
# With $FAKE_PODMAN_REFUSE set, "run" fails as podman does when it cannot
# create a container: exit 125.
set -euo pipefail
: "${FAKE_PODMAN_DIR:?}"

end() {
  local name=$1 grace=$2 pidfile="$FAKE_PODMAN_DIR/$1.pid"
  [ -f "$pidfile" ] || return 0
  local pid
  pid=$(cat "$pidfile")
  rm -f "$pidfile"
  kill -TERM "$pid" 2>/dev/null || return 0
  for _ in $(seq 1 $((grace * 20))); do
    kill -0 "$pid" 2>/dev/null || return 0
    sleep 0.05
  done
  kill -KILL "$pid" 2>/dev/null || true
}

sub=${1:-}
[ $# -eq 0 ] || shift
case "$sub" in
  stop|rm)
    echo "$sub $*" >> "$FAKE_PODMAN_DIR/calls"
    grace=10
    name=
    for a in "$@"; do
      case "$a" in
        --time=*) grace=${a#--time=} ;;
        --*)      ;;
        *)        name=$a ;;
      esac
    done
    [ -n "$name" ] || { echo "fake-podman: $sub: no container" >&2; exit 125; }
    end "$name" "$grace"
    exit 0 ;;
  run) ;;
  *) echo "fake-podman: unexpected command: $sub $*" >&2; exit 125 ;;
esac

name=
dir=
env=()
envfiles=()
volumes=()
all=("$@")
while [ $# -gt 0 ]; do
  case "$1" in
    --name=*)     name=${1#--name=} ;;
    --workdir=*)  dir=${1#--workdir=} ;;
    --env=*)      env+=("${1#--env=}") ;;
    --env-file=*) envfiles+=("${1#--env-file=}") ;;
    --volume=*)   volumes+=("${1#--volume=}") ;;
    --*)          ;;
    *)            break ;;
  esac
  shift
done
[ -n "$name" ] || { echo "fake-podman: no --name" >&2; exit 125; }
[ $# -ge 2 ] || { echo "fake-podman: no image and command" >&2; exit 125; }
printf '%s\n' "${all[@]}" > "$FAKE_PODMAN_DIR/$name.args"
if [ -n "${FAKE_PODMAN_REFUSE:-}" ]; then
  echo "Error: $1: image not known" >&2
  exit 125
fi
shift # the image

for envfile in ${envfiles[@]+"${envfiles[@]}"}; do
  while IFS= read -r line; do
    [ -z "$line" ] || env+=("$line")
  done < "$envfile"
done
# A path of the container that is another one on the host.
for v in ${volumes[@]+"${volumes[@]}"}; do
  src=${v%%:*}
  rest=${v#*:}
  dst=${rest%%:*}
  [ "$src" != "$dst" ] || continue
  for i in "${!env[@]}"; do
    [ "${env[$i]#*=}" != "$dst" ] || env[$i]="${env[$i]%%=*}=$src"
  done
done

[ -z "$dir" ] || cd "$dir"
echo $$ > "$FAKE_PODMAN_DIR/$name.pid"
exec /usr/bin/env -i PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin ${env[@]+"${env[@]}"} "$@"
