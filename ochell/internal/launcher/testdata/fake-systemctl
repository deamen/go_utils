#!/bin/bash
# Test stand-in for "systemctl stop -- <unit>.service": it ends the process
# that fake-systemd-run started. Exit 5 when there is no such unit, as
# systemctl does.
set -euo pipefail
: "${FAKE_SYSTEMD_DIR:?}"
[ "$1" = stop ] && [ "$2" = -- ] || { echo "fake-systemctl: unexpected arguments: $*" >&2; exit 1; }
unit=${3%.service}
echo "$*" >> "$FAKE_SYSTEMD_DIR/systemctl.calls"
pidfile="$FAKE_SYSTEMD_DIR/$unit.pid"
[ -f "$pidfile" ] || exit 5
pid=$(cat "$pidfile")
rm -f "$pidfile"
kill -TERM "$pid" 2>/dev/null || exit 5
for _ in $(seq 1 100); do
  kill -0 "$pid" 2>/dev/null || exit 0
  sleep 0.05
done
kill -KILL "$pid" 2>/dev/null || true
